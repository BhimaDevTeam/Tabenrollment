<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS Application alias must be: /vrudhitabenrollment
  Physical path can be this folder (must contain index.html + static/).
  Requires: URL Rewrite module
-->
<configuration>

    <!-- ==================================================================== -->
    <!--  COUNTRY / REGION SELECTION CONFIGURATION                            -->
    <!-- ==================================================================== -->
    <!-- 
      To switch region configuration:
      - For INDIA (Current active setting): Keep India keys enabled and Singapore commented out.
      - For SINGAPORE (SNG): Comment out India keys and uncomment Singapore keys.
    -->
    <appSettings>
        <!-- ACTIVE REGION: INDIA -->
        <add key="SelectedCountry" value="India" />
        <add key="CountryCode" value="IN" />
        <add key="Currency" value="INR" />
        <add key="VrudhiPortalApiUrl" value="https://vrudhi.bhima.info/VrudhiPortalAPI" />
        <add key="NewMemberApiUrl" value="https://vrudhi.bhima.info/VrudhiPortalAPI/api/payment-gateway/newmember-creationTE" />

        <!-- ==================================================================== -->
        <!--  PAYMENT MODE CONFIGURATION (Online / Offline / Both)                -->
        <!-- ==================================================================== -->
        <!-- 
          Supported Options:
          - "Both"    : Enables both Online and Offline enrollment payment options.
          - "Offline" : Enables ONLY Offline enrollment option (Current active setting).
          - "Online"  : Enables ONLY Online enrollment option.
        -->
        <!-- ACTIVE PAYMENT MODE: Offline -->
        <add key="PaymentMode" value="Offline" />
        <!--
        <add key="PaymentMode" value="Both" />
        <add key="PaymentMode" value="Online" />
        -->

        <!-- ==================================================================== -->
        <!--  E-KYC AND E-SIGN CONFIGURATION (1 = Enabled/Displayed, 0 = Disabled)-->
        <!-- ==================================================================== -->
        <!-- 
          Supported Values:
          - "1" : Display & require eKYC and eSign / Customer Signature.
          - "0" : Disable / hide eKYC and eSign / Signature features (Current active setting).
        -->
        <!-- ACTIVE FEATURE FLAGS: 0 (Disabled) -->
        <add key="EnableEkyc" value="0" />
        <add key="EnableEsign" value="0" />
        <!--
        <add key="EnableEkyc" value="1" />
        <add key="EnableEsign" value="1" />
        -->

        <!-- ==================================================================== -->
        <!--  SIGNATURE EMAIL CONFIGURATION                                        -->
        <!-- ==================================================================== -->
        <!-- 
          Controls whether the digital signature email is automatically sent
          to the customer when Save is clicked on the final enrollment step.
          Supported Values:
          - "1" : Send signature email on Save (default behavior).
          - "0" : Skip signature email on Save — CURRENT ACTIVE SETTING (India).
        -->
        <!-- ACTIVE: Signature email DISABLED on Save -->
        <add key="EnableSignatureEmail" value="0" />
        <!--
        <add key="EnableSignatureEmail" value="1" />
        -->

        <!-- SINGAPORE (SNG) CONFIGURATION (Uncomment when switching to Singapore) -->
        <!--
        <add key="SelectedCountry" value="Singapore" />
        <add key="CountryCode" value="SG" />
        <add key="Currency" value="SGD" />
        <add key="VrudhiPortalApiUrl" value="https://vrudhi.bhima.info/VrudhiPortalAPISG" />
        <add key="NewMemberApiUrl" value="https://vrudhi.bhima.info/VrudhiPortalAPISG/api/payment-gateway/newmember-creationTE" />
        -->
    </appSettings>

    <system.webServer>
        <directoryBrowse enabled="false" />
        <defaultDocument enabled="true">
            <files>
                <clear />
                <add value="index.html" />
            </files>
        </defaultDocument>
        <staticContent>
            <remove fileExtension=".webp" />
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
            <remove fileExtension=".json" />
            <mimeMap fileExtension=".json" mimeType="application/json" />
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
        </staticContent>
        <httpProtocol>
            <customHeaders>
                <!-- HTTP Header for Active Region -->
                <!-- ACTIVE REGION: INDIA -->
                <add name="X-App-Country" value="India" />
                <add name="X-App-Country-Code" value="IN" />
                
                <!-- HTTP Header for Active Payment Mode (Both / Offline / Online) -->
                <add name="X-App-Payment-Mode" value="Offline" />
                
                <!-- HTTP Headers for Active Feature Flags (0 = Disabled, 1 = Enabled) -->
                <add name="X-App-Enable-Ekyc" value="0" />
                <add name="X-App-Enable-Esign" value="0" />
                <!-- Signature email on Save: 0 = Disabled, 1 = Enabled -->
                <add name="X-App-Enable-Signature-Email" value="0" />
                
                <!-- SINGAPORE (SNG) HEADER (Uncomment when switching to Singapore) -->
                <!--
                <add name="X-App-Country" value="Singapore" />
                <add name="X-App-Country-Code" value="SG" />
                -->
            </customHeaders>
        </httpProtocol>
        <rewrite>
            <rules>
                <rule name="React SPA" stopProcessing="true">
                    <match url=".*" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="/vrudhitabenrollment/index.html" />
                </rule>
            </rules>
        </rewrite>
        <httpErrors existingResponse="PassThrough" />
    </system.webServer>
</configuration>
